# Valores públicos do projeto Supabase. A publishable key pode ser exposta ao browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Não adicionar service-role keys à aplicação web.

# Governance: hash scrypt da access key e segredo aleatório server-only (mínimo 32 caracteres).
# Nunca usar nenhum destes valores como chave de cifragem do Vault.
GOVERNANCE_ACCESS_KEY_HASH=
GOVERNANCE_SESSION_SECRET=

# Vault: chave AES-256-GCM independente e respetiva versão.
# Gerar VAULT_ENCRYPTION_KEY com: openssl rand -base64 32
VAULT_ENCRYPTION_KEY=
VAULT_KEY_VERSION=1

# Google OAuth server-side. O redirect deve coincidir exatamente com o Google Auth Platform.
# Gerar GOOGLE_TOKEN_ENCRYPTION_KEY com: openssl rand -base64 32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3002/api/google/oauth/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=
